<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================================
         Generated from design-tokens.json — Dark palette.
         Edit design-tokens.json; do not edit this file by hand.
         ============================================================ -->

    <!-- ── Core surface colors ─────────────────────────────────── -->
    <Color x:Key="Color.Background">#15161A</Color>
    <Color x:Key="Color.Surface">#1E1F24</Color>
    <Color x:Key="Color.SurfaceAlt">#26272D</Color>
    <Color x:Key="Color.SurfaceRaised">#212229</Color>
    <Color x:Key="Color.Sidebar">#0F1423</Color>

    <!-- ── Text colors ──────────────────────────────────────────── -->
    <Color x:Key="Color.TextPrimary">#E8E9EA</Color>
    <Color x:Key="Color.TextSecondary">#9CA3AF</Color>
    <Color x:Key="Color.TextDisabled">#4B5563</Color>
    <Color x:Key="Color.TextMuted">#6B7280</Color>

    <!-- ── Border colors ────────────────────────────────────────── -->
    <Color x:Key="Color.Border">#2C2D33</Color>
    <Color x:Key="Color.BorderStrong">#3F4047</Color>

    <!-- ── Accent / primary ──────────────────────────────────────── -->
    <Color x:Key="Color.Primary">#4F8BF9</Color>
    <Color x:Key="Color.PrimaryHover">#6B9FFF</Color>
    <Color x:Key="Color.OnPrimary">#0D1117</Color>
    <Color x:Key="Color.PrimaryContainer">#1E3A8A</Color>
    <Color x:Key="Color.OnPrimaryContainer">#DBEAFE</Color>

    <!-- ── Navigation colors ────────────────────────────────────── -->
    <Color x:Key="Color.NavSelected">#3B5BDB</Color>
    <Color x:Key="Color.NavHover">#2C2D33</Color>

    <!-- ── Semantic status colors ───────────────────────────────── -->
    <Color x:Key="Color.Success">#4ADE80</Color>
    <Color x:Key="Color.OnSuccess">#052E16</Color>
    <Color x:Key="Color.SuccessContainer">#14532D</Color>
    <Color x:Key="Color.Warning">#FBBF24</Color>
    <Color x:Key="Color.OnWarning">#451A03</Color>
    <Color x:Key="Color.WarningContainer">#78350F</Color>
    <Color x:Key="Color.Error">#F87171</Color>
    <Color x:Key="Color.ErrorHover">#FCA5A5</Color>
    <Color x:Key="Color.OnError">#450A0A</Color>
    <Color x:Key="Color.ErrorContainer">#7F1D1D</Color>
    <Color x:Key="Color.Info">#4F8BF9</Color>

    <!-- ── Interaction colors ────────────────────────────────────── -->
    <Color x:Key="Color.Focus">#6B9FFF</Color>
    <Color x:Key="Color.DisabledSurface">#26272D</Color>
    <Color x:Key="Color.DisabledContent">#4B5563</Color>

    <!-- ── Inverse / overlay (for sidebar light-on-dark elements) ── -->
    <Color x:Key="Color.InverseSurface">#F8FAFC</Color>
    <Color x:Key="Color.InverseSurfaceAlt">#E2E8F0</Color>
    <Color x:Key="Color.OnInverseSurface">#0F172A</Color>
    <Color x:Key="Color.OnInverseSurfaceMuted">#475569</Color>
    <Color x:Key="Color.MediaScrim">#CC000000</Color>
    <Color x:Key="Color.Overlay">#B3000000</Color>

    <!-- ── Icon badge colors (stat cards, quick actions) ────────── -->
    <Color x:Key="Color.IconContacts">#3B82F6</Color>
    <Color x:Key="Color.IconPhotos">#10B981</Color>
    <Color x:Key="Color.IconGroups">#8B5CF6</Color>
    <Color x:Key="Color.IconStorage">#64748B</Color>

    <!-- ============================================================
         Brushes — semantic names, DynamicResource-safe.
         ============================================================ -->

    <!-- Surface brushes -->
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />

    <!-- Text brushes -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />

    <!-- Border brushes -->
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />

    <!-- Accent / primary brushes -->
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="{StaticResource Color.OnPrimary}" />
    <SolidColorBrush x:Key="Brush.PrimaryContainer" Color="{StaticResource Color.PrimaryContainer}" />
    <SolidColorBrush x:Key="Brush.OnPrimaryContainer" Color="{StaticResource Color.OnPrimaryContainer}" />

    <!-- Navigation brushes -->
    <SolidColorBrush x:Key="Brush.NavSelected" Color="{StaticResource Color.NavSelected}" />
    <SolidColorBrush x:Key="Brush.NavHover" Color="{StaticResource Color.NavHover}" />

    <!-- Status brushes -->
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.OnSuccess" Color="{StaticResource Color.OnSuccess}" />
    <SolidColorBrush x:Key="Brush.SuccessContainer" Color="{StaticResource Color.SuccessContainer}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.OnWarning" Color="{StaticResource Color.OnWarning}" />
    <SolidColorBrush x:Key="Brush.WarningContainer" Color="{StaticResource Color.WarningContainer}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.ErrorHover" Color="{StaticResource Color.ErrorHover}" />
    <SolidColorBrush x:Key="Brush.OnError" Color="{StaticResource Color.OnError}" />
    <SolidColorBrush x:Key="Brush.ErrorContainer" Color="{StaticResource Color.ErrorContainer}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />

    <!-- Interaction brushes -->
    <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}" />
    <SolidColorBrush x:Key="Brush.DisabledSurface" Color="{StaticResource Color.DisabledSurface}" />
    <SolidColorBrush x:Key="Brush.DisabledContent" Color="{StaticResource Color.DisabledContent}" />

    <!-- Inverse / overlay brushes -->
    <SolidColorBrush x:Key="Brush.InverseSurface" Color="{StaticResource Color.InverseSurface}" />
    <SolidColorBrush x:Key="Brush.InverseSurfaceAlt" Color="{StaticResource Color.InverseSurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.OnInverseSurface" Color="{StaticResource Color.OnInverseSurface}" />
    <SolidColorBrush x:Key="Brush.OnInverseSurfaceMuted" Color="{StaticResource Color.OnInverseSurfaceMuted}" />
    <SolidColorBrush x:Key="Brush.MediaScrim" Color="{StaticResource Color.MediaScrim}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />

    <!-- Icon badge brushes -->
    <SolidColorBrush x:Key="Brush.IconContacts" Color="{StaticResource Color.IconContacts}" />
    <SolidColorBrush x:Key="Brush.IconPhotos" Color="{StaticResource Color.IconPhotos}" />
    <SolidColorBrush x:Key="Brush.IconGroups" Color="{StaticResource Color.IconGroups}" />
    <SolidColorBrush x:Key="Brush.IconStorage" Color="{StaticResource Color.IconStorage}" />

    <!-- Icon badge container brushes (semi-transparent fills) -->
    <Color x:Key="Color.IconContactsContainer">#1A3B82F6</Color>
    <Color x:Key="Color.IconPhotosContainer">#1A10B981</Color>
    <Color x:Key="Color.IconGroupsContainer">#1A8B5CF6</Color>
    <Color x:Key="Color.IconStorageContainer">#1A64748B</Color>
    <SolidColorBrush x:Key="Brush.IconContactsContainer" Color="{StaticResource Color.IconContactsContainer}" />
    <SolidColorBrush x:Key="Brush.IconPhotosContainer" Color="{StaticResource Color.IconPhotosContainer}" />
    <SolidColorBrush x:Key="Brush.IconGroupsContainer" Color="{StaticResource Color.IconGroupsContainer}" />
    <SolidColorBrush x:Key="Brush.IconStorageContainer" Color="{StaticResource Color.IconStorageContainer}" />

    <!-- App chrome gradient (hero panel illustration area) -->
    <LinearGradientBrush x:Key="AppChromeGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.Background}" Offset="0" />
        <GradientStop Color="{StaticResource Color.PrimaryContainer}" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
