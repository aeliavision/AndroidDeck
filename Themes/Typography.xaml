<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Base implicit styles ─────────────────────────────────── -->

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── Named text role styles ───────────────────────────────── -->

    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="HeadingText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Heading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SubHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Body}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource HeadingText}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.PageTitle}" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="PageSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Margin" Value="0,5,0,0" />
    </Style>

    <!-- ── New text roles added in Phase 1 ──────────────────────── -->

    <!-- Large numeric value on statistic cards (e.g. "142", "0 B") -->
    <Style x:Key="StatValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.StatValue}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Muted caption-level text (section group labels, timestamps) -->
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>

    <!-- Sidebar navigation section group labels (OVERVIEW, PHONE DATA…) -->
    <Style x:Key="NavSectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.NavSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Quick-action card primary label -->
    <Style x:Key="QuickActionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.QuickAction}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- Quick-action card secondary description -->
    <Style x:Key="QuickActionSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- Hero panel primary title ("No device connected", "Phone connected") -->
    <Style x:Key="HeroTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.HeroTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Hero panel subtitle description -->
    <Style x:Key="HeroSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
