<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PageHeaderPanel" TargetType="Border" BasedOn="{StaticResource ModernCard}">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
    </Style>

    <Style x:Key="CommandBarPanel" TargetType="Border" BasedOn="{StaticResource ModernCard}">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    </Style>

    <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource ModernCard}">
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="StatusBanner" TargetType="Border" BasedOn="{StaticResource ModernCard}">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
    </Style>

    <Style x:Key="StatusBanner.Warning" TargetType="Border" BasedOn="{StaticResource StatusBanner}">
        <Setter Property="Background" Value="{DynamicResource Brush.WarningContainer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
    </Style>

    <Style x:Key="StatusBanner.Error" TargetType="Border" BasedOn="{StaticResource StatusBanner}">
        <Setter Property="Background" Value="{DynamicResource Brush.ErrorContainer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
    </Style>

    <Style x:Key="StatusBanner.Success" TargetType="Border" BasedOn="{StaticResource StatusBanner}">
        <Setter Property="Background" Value="{DynamicResource Brush.SuccessContainer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
    </Style>

    <Style x:Key="EmptyStatePanel" TargetType="Border" BasedOn="{StaticResource ModernCard}">
        <Setter Property="Padding" Value="32" />
        <Setter Property="MinHeight" Value="180" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="OperationCenterCard" TargetType="Border" BasedOn="{StaticResource ModernCard}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryContainer}" />
    </Style>

    <Style x:Key="ContextCommandButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <Style x:Key="PrimaryCommandButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <Style x:Key="DestructiveCommandButton" TargetType="Button" BasedOn="{StaticResource DangerButton}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <Style x:Key="Dialog.Window" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Application}" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="MinWidth" Value="420" />
        <Setter Property="MaxWidth" Value="{StaticResource DialogWidth.Maximum}" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
    </Style>

    <Style x:Key="Dialog.Title" TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Dialog.Body" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="Dialog.PrimaryAction" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="IsDefault" Value="True" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <Style x:Key="Dialog.SecondaryAction" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="IsCancel" Value="True" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <Style x:Key="Dialog.DestructiveAction" TargetType="Button" BasedOn="{StaticResource DangerButton}">
        <Setter Property="IsDefault" Value="False" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <Style x:Key="ValidationSummary" TargetType="Border" BasedOn="{StaticResource StatusBanner.Error}">
        <Setter Property="Padding" Value="10" />
    </Style>

    <StaticResource x:Key="MediaScrimBrush" ResourceKey="Brush.MediaScrim" />
</ResourceDictionary>
