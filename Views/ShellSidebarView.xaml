<UserControl x:Class="VcfEditor.Views.ShellSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:views="clr-namespace:VcfEditor.Views"
             mc:Ignorable="d"
             d:DesignWidth="296"
             Background="Transparent">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedNavigationItems" Source="{Binding NavigationItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupLabel" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="GroupOrder" Direction="Ascending" />
                <scm:SortDescription PropertyName="ItemOrder" Direction="Ascending" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Border BorderThickness="0,0,1,0">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Shell.SidebarBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Shell.SidebarSeparatorBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Top" Padding="12,16,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AreNavigationLabelsVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="AndroidDeck"
                                   Style="{StaticResource Shell.SidebarTitleText}" />
                        <TextBlock Text="Secure local device manager"
                                   Style="{StaticResource Shell.SidebarSubtitleText}"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="Created by Walid Salameh"
                                   Style="{StaticResource Shell.SidebarSubtitleText}"
                                   Opacity="0.7"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding ToggleSidebarCommand}"
                            Visibility="{Binding IsSidebarToggleVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="{Binding SidebarToggleAutomationName}"
                            AutomationProperties.Name="{Binding SidebarToggleAutomationName}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Shell.SidebarIconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AreNavigationLabelsVisible}" Value="False">
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource FontSize.BodyLarge}" Text="&#xE700;" />
                    </Button>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Padding="10,12"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource Shell.SidebarSeparatorBrush}">
                <views:PhoneConnectionStatusView />
            </Border>

            <ListBox x:Name="NavigationList"
                     Style="{StaticResource Shell.NavigationList}"
                     ItemsSource="{Binding Source={StaticResource GroupedNavigationItems}}"
                     SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                     SelectionMode="Single"
                     AutomationProperties.Name="Main navigation">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="20,12,12,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Shell.SidebarSectionLabelText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.AreNavigationLabelsVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Shell.NavigationItem}">
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding AutomationHelpText}" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="24">
                            <TextBlock Text="{Binding IconGlyph}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource IconSize.Nav}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.AreNavigationLabelsVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding Label}"
                                       FontSize="{StaticResource FontSize.NavLabel}"
                                       FontWeight="Medium"
                                       Margin="38,0,36,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.AreNavigationLabelsVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Shell.NavigationBadge}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.AreNavigationLabelsVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                <Setter Property="MinWidth" Value="8" />
                                                <Setter Property="Width" Value="8" />
                                                <Setter Property="Height" Value="8" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="VerticalAlignment" Value="Top" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BadgeText}"
                                           FontSize="{StaticResource FontSize.NavBadge}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.AreNavigationLabelsVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
