<views:AppDialogWindow x:Class="VcfEditor.Views.EditContactDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VcfEditor.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VcfEditor"
        xmlns:models="clr-namespace:VcfEditor.Models"
        xmlns:helpers="clr-namespace:VcfEditor.Helpers"
        mc:Ignorable="d"
        Title="Edit Contact"
        Height="760" Width="700" MinHeight="520" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">

    <Window.Resources>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" />
    </Window.Resources>

    <!-- Main Layout -->
    <Grid Margin="12" Background="{DynamicResource Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Primary}"
                CornerRadius="{StaticResource RadiusMd}" Padding="12" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Edit Contact" Foreground="{DynamicResource Brush.OnPrimary}"
                           FontSize="{StaticResource FontSize.Title}" FontWeight="SemiBold"/>
                <TextBlock Text="Update contact details" Foreground="{DynamicResource Brush.OnPrimary}"
                           FontSize="{StaticResource FontSize.Caption}" Opacity="0.9"/>
            </StackPanel>
        </Border>

        <!-- Read-Only Warning -->
        <Border Grid.Row="1" Margin="0,0,0,10"
                Background="{DynamicResource Brush.ErrorContainer}"
                BorderBrush="{DynamicResource Brush.Error}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}" Padding="12"
                Visibility="{Binding IsEditable, Converter={StaticResource InverseBoolToVisConverter}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="This contact is read-only (managed by an external app like WhatsApp) and cannot be edited."
                           Foreground="{DynamicResource Brush.Error}"
                           FontSize="{StaticResource FontSize.Caption}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ValidationSummaryText" Grid.Row="1"
                   Visibility="Collapsed" Foreground="{DynamicResource Brush.Error}"
                   TextWrapping="Wrap" Margin="12,0,12,10"
                   AutomationProperties.LiveSetting="Assertive" />

        <!-- Form -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsEditable}">
            <StackPanel>

                <!-- Personal Information -->
                <Border Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
                        Margin="0,0,0,8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Personal Information"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="{StaticResource FontSize.BodyLarge}"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Prefix" Grid.Row="0" Grid.Column="0" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="{StaticResource FontSize.Body}" Margin="0,2,8,2"/>
                            <TextBox Text="{Binding Contact.Prefix}" Grid.Row="0" Grid.Column="1" Margin="0,2" Style="{StaticResource ModernTextBox}"/>

                            <TextBlock Text="First name" Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="{StaticResource FontSize.Body}" Margin="0,2,8,2"/>
                            <TextBox x:Name="FirstNameTextBox" Text="{Binding Contact.FirstName}" Grid.Row="1" Grid.Column="1" Margin="0,2"
                                     Style="{StaticResource ModernTextBox}" AutomationProperties.Name="First name"/>

                            <TextBlock Text="Middle name" Grid.Row="2" Grid.Column="0" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="{StaticResource FontSize.Body}" Margin="0,2,8,2"/>
                            <TextBox Text="{Binding Contact.MiddleName}" Grid.Row="2" Grid.Column="1" Margin="0,2" Style="{StaticResource ModernTextBox}"/>

                            <TextBlock Text="Last name" Grid.Row="3" Grid.Column="0" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="{StaticResource FontSize.Body}" Margin="0,2,8,2"/>
                            <TextBox Text="{Binding Contact.LastName}" Grid.Row="3" Grid.Column="1" Margin="0,2" Style="{StaticResource ModernTextBox}"/>

                            <TextBlock Text="Suffix" Grid.Row="4" Grid.Column="0" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="{StaticResource FontSize.Body}" Margin="0,2,8,2"/>
                            <TextBox Text="{Binding Contact.Suffix}" Grid.Row="4" Grid.Column="1" Margin="0,2" Style="{StaticResource ModernTextBox}"/>

                            <TextBlock Text="Full name" Grid.Row="5" Grid.Column="0" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="{StaticResource FontSize.Body}" Margin="0,2,8,2"/>
                            <TextBox Text="{Binding Contact.FullName}" Grid.Row="5" Grid.Column="1"
                                     Margin="0,2" IsReadOnly="True"
                                     Style="{StaticResource ModernTextBox}"
                                     Background="{DynamicResource Brush.SurfaceAlt}"
                                     Foreground="{DynamicResource Brush.TextSecondary}"
                                     AutomationProperties.Name="Full name (read-only, computed)"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Professional Details -->
                <Border Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
                        Margin="0,0,0,8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Professional Details"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="{StaticResource FontSize.BodyLarge}"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Organization" Grid.Row="0" Grid.Column="0" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="{StaticResource FontSize.Body}" Margin="0,2,8,2"/>
                            <TextBox Text="{Binding Contact.Organization}" Grid.Row="0" Grid.Column="1" Margin="0,2" Style="{StaticResource ModernTextBox}"/>

                            <TextBlock Text="Job title" Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="{StaticResource FontSize.Body}" Margin="0,2,8,2"/>
                            <TextBox Text="{Binding Contact.Title}" Grid.Row="1" Grid.Column="1" Margin="0,2" Style="{StaticResource ModernTextBox}"/>

                            <TextBlock Text="Email" Grid.Row="2" Grid.Column="0" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="{StaticResource FontSize.Body}" Margin="0,2,8,2"/>
                            <TextBox Text="{Binding Contact.Email}" Grid.Row="2" Grid.Column="1" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Phone Numbers -->
                <Border Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
                        Margin="0,0,0,8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Phone Numbers"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="{StaticResource FontSize.BodyLarge}"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ListView Name="PhoneNumbersListView" ItemsSource="{Binding Contact.PhoneNumbers}"
                                  Height="100" Margin="0,2" Background="Transparent" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Number" Width="220" DisplayMemberBinding="{Binding Number}" />
                                    <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding TypeDisplayName}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Content="Add" Click="AddPhone_Click" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="Edit" Click="EditPhone_Click" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"/>
                            <Button Content="Remove" Click="RemovePhone_Click" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
                Padding="6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Click="Ok_Click"
                        Style="{StaticResource Dialog.PrimaryAction}"
                        IsEnabled="{Binding IsEditable}" IsDefault="True"/>
                <Button Content="Cancel" Click="Cancel_Click"
                        Style="{StaticResource Dialog.SecondaryAction}"
                        Margin="6,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</views:AppDialogWindow>
