<Window x:Class="VcfEditor.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:VcfEditor.Behaviors"
        xmlns:views="clr-namespace:VcfEditor.Views"
        mc:Ignorable="d"
        Title="{Binding CurrentTitle, StringFormat={}{0} — AndroidDeck}"
        Height="900"
        Width="1440"
        MinHeight="560"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource FontFamily.Application}">
    <Window.InputBindings>
        <KeyBinding Key="D" Modifiers="Alt" Command="{Binding NavigateByKeyCommand}" CommandParameter="dashboard" />
        <KeyBinding Key="C" Modifiers="Alt" Command="{Binding NavigateByKeyCommand}" CommandParameter="contacts" />
        <KeyBinding Key="F" Modifiers="Alt" Command="{Binding NavigateByKeyCommand}" CommandParameter="files" />
        <KeyBinding Key="G" Modifiers="Alt" Command="{Binding NavigateByKeyCommand}" CommandParameter="gallery" />
        <KeyBinding Key="B" Modifiers="Alt" Command="{Binding NavigateByKeyCommand}" CommandParameter="backup" />
        <KeyBinding Key="S" Modifiers="Alt" Command="{Binding NavigateByKeyCommand}" CommandParameter="settings" />
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding GlobalSearchCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseOverlayCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding DesktopSidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:ShellSidebarView x:Name="DesktopSidebar" Grid.Column="0"
                                Visibility="{Binding IsDesktopSidebarVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Grid Grid.Column="1" Background="{DynamicResource Brush.Background}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="IsEnabled" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOverlayVisible}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource Shell.Header.GridLength}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Top header bar ─────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="12,0,16,0">
                    <Grid.ColumnDefinitions>
                        <!-- Left: hamburger (overlay mode) + page title + subtitle -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Spacer -->
                        <ColumnDefinition Width="*" />
                        <!-- Right: search + bell + avatar -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column: hamburger + stacked title/subtitle -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="OverlayOpenButton"
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource IconButton}"
                                Command="{Binding ToggleSidebarCommand}"
                                Visibility="{Binding IsOverlayMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="{Binding SidebarToggleAutomationName}"
                                AutomationProperties.Name="{Binding SidebarToggleAutomationName}"
                                Margin="0,0,8,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource IconSize.Md}"
                                       Text="&#xE700;" />
                        </Button>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTitle}"
                                       Style="{StaticResource PageTitleText}"
                                       AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock Text="{Binding CurrentSubtitle}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding HasCurrentSubtitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right column: search pill + notification bell + avatar -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">



                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Page content area ──────────────────────────────── -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentContent}"
                            Focusable="False"
                            AutomationProperties.Name="{Binding CurrentTitle}" />
        </Grid>

        <!-- ── Overlay sidebar (hamburger / narrow window) ───────── -->
        <Grid x:Name="OverlayHost"
              Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Visibility="Collapsed"
              Opacity="0"
              IsHitTestVisible="False"
              KeyboardNavigation.TabNavigation="Cycle"
              FocusManager.IsFocusScope="True"
              behaviors:OverlayDrawerBehavior.IsOpen="{Binding IsOverlayVisible}"
              behaviors:OverlayDrawerBehavior.Drawer="{Binding ElementName=OverlaySidebar}">
            <Button Style="{StaticResource Shell.OverlayDismissButton}"
                    Command="{Binding CloseOverlayCommand}"
                    Focusable="False"
                    AutomationProperties.Name="Close navigation menu" />
            <views:ShellSidebarView x:Name="OverlaySidebar"
                                    Width="296"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch" />
        </Grid>

        <!-- ── Screen-reader live-region announcement ────────────── -->
        <TextBlock Grid.ColumnSpan="2"
                   Width="1"
                   Height="1"
                   Opacity="0"
                   IsHitTestVisible="False"
                   Text="{Binding NavigationAnnouncement}"
                   AutomationProperties.Name="{Binding NavigationAnnouncement}"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
