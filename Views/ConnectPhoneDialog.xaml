<views:AppDialogWindow x:Class="VcfEditor.Views.ConnectPhoneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VcfEditor.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Connect to Android Phone"
        Height="680" Width="480" MinHeight="520" MinWidth="440"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Primary}"
                CornerRadius="{StaticResource RadiusXl}" Padding="18" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Connect to Android Phone"
                           Foreground="{DynamicResource Brush.OnPrimary}"
                           FontSize="{StaticResource FontSize.Title}"
                           FontWeight="SemiBold" HorizontalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock Text="Pair your phone via Wi-Fi or USB Debugging"
                           Foreground="{DynamicResource Brush.OnPrimary}"
                           FontSize="{StaticResource FontSize.Caption}"
                           Opacity="0.9" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Scrollable Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">

                <!-- Connection Form -->
                <Border Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusXl}" Padding="22">
                    <StackPanel>

                        <!-- Connection Mode -->
                        <TextBlock Text="Connection Mode" FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSize.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton Name="WifiRadio" Content="Wi-Fi" IsChecked="True"
                                         Margin="0,0,20,0" FontSize="{StaticResource FontSize.NavLabel}"
                                         Checked="ConnectionMode_Changed"/>
                            <RadioButton Name="UsbRadio" Content="USB (ADB)"
                                         FontSize="{StaticResource FontSize.NavLabel}"
                                         Checked="ConnectionMode_Changed"/>
                        </StackPanel>

                        <!-- USB Device Selection -->
                        <StackPanel Name="UsbDevicePanel" Visibility="Collapsed" Margin="0,0,0,16">
                            <TextBlock Text="Select Android Device"
                                       FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Name="DeviceComboBox" Grid.Column="0" Height="34"
                                          MaxWidth="280" HorizontalAlignment="Stretch"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="DeviceComboBox_SelectionChanged"/>
                                <Button Grid.Column="1" Content="Refresh" Margin="8,0,0,0"
                                        ToolTip="Refresh Device List" Click="RefreshDevices_Click"
                                        Style="{StaticResource SecondaryButton}" Padding="4"/>
                            </Grid>

                            <!-- App Installation Status -->
                            <Border Name="AppInstallPanel"
                                    Background="{DynamicResource Brush.Background}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusLg}"
                                    Margin="0,12,0,0" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Name="AppStatusIcon" Text="" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Name="AppStatusText"
                                                   Text="Select a device to check for companion app"
                                                   FontSize="{StaticResource FontSize.Caption}"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ProgressBar Name="AppStatusProgress" Height="4"
                                                 IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8"/>

                                    <StackPanel Name="ApkPathPanel" Visibility="Collapsed">
                                        <TextBlock Text="APK Path"
                                                   FontSize="{StaticResource FontSize.Caption}"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Margin="0,4,0,2"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Name="ApkPathTextBox" Grid.Column="0"
                                                     IsReadOnly="True"
                                                     FontSize="{StaticResource FontSize.Caption}"
                                                     Padding="6,4"
                                                     Background="{DynamicResource Brush.Surface}"
                                                     Style="{StaticResource ModernTextBox}"/>
                                            <Button Grid.Column="1" Content="..." Width="30"
                                                    Margin="4,0,0,0" Click="BrowseApk_Click"
                                                    Style="{StaticResource SecondaryButton}" Padding="2"/>
                                        </Grid>
                                    </StackPanel>

                                    <Button Name="InstallAppButton" Content="Install Companion App"
                                            Click="InstallApp_Click"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,8,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- IP Address (Wi-Fi mode) -->
                        <StackPanel Name="WifiIpPanel">
                            <TextBlock Text="IP Address" FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       Margin="0,0,0,6"/>
                            <TextBox Name="IpAddressTextBox" Text="192.168."
                                     Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"/>
                            <TextBlock Name="IpValidationText" Visibility="Collapsed"
                                       FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{DynamicResource Brush.Error}"
                                       Margin="0,0,0,12" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Port -->
                        <TextBlock Text="Port" FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSize.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,0,0,6"/>
                        <TextBox Name="PortTextBox" Text="8732"
                                 Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"/>
                        <TextBlock Name="PortValidationText" Visibility="Collapsed"
                                   FontSize="{StaticResource FontSize.Caption}"
                                   Foreground="{DynamicResource Brush.Error}"
                                   Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <!-- Pairing Code -->
                        <TextBlock Text="Pairing Code" FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSize.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,0,0,6"/>
                        <TextBox Name="PairingCodeTextBox" Style="{StaticResource ModernTextBox}"
                                 MaxLength="6" FontSize="{StaticResource FontSize.Title}"
                                 FontWeight="Bold" TextAlignment="Center"
                                 CharacterCasing="Upper" Margin="0,0,0,4"
                                 AutomationProperties.Name="Six-digit pairing code"/>
                        <TextBlock Name="PairingValidationText" Visibility="Collapsed"
                                   FontSize="{StaticResource FontSize.Caption}"
                                   Foreground="{DynamicResource Brush.Error}"
                                   Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <TextBlock Name="HintText"
                                   Text="Open the VCard Editor app on your phone to see these details."
                                   FontSize="{StaticResource FontSize.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Certificate Fingerprint Verification -->
                <Border Name="CertFingerprintBorder" Margin="0,12,0,0" Visibility="Collapsed"
                        Background="{DynamicResource Brush.Background}"
                        BorderBrush="{DynamicResource Brush.Success}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Verify Certificate Fingerprint (SHA-256)"
                                       FontSize="{StaticResource FontSize.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Compare this fingerprint with the one shown in the companion app on your phone to confirm you are connected to the right device."
                                   FontSize="{StaticResource FontSize.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Success}"
                                BorderThickness="1" CornerRadius="4" Padding="8,6">
                            <TextBlock Name="CertFingerprintText" Text=""
                                       FontSize="{StaticResource FontSize.Caption}"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Name="CopyCertButton" Content="Copy" Click="CopyCert_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,4" FontSize="{StaticResource FontSize.Caption}"
                                    Margin="0,0,8,0"/>
                            <Button Name="CertVerifiedButton" Content="Fingerprint Matches"
                                    Click="CertVerified_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="8,4" FontSize="{StaticResource FontSize.Caption}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Status Area -->
                <Border Name="StatusBorder" Margin="0,12,0,0" Visibility="Collapsed"
                        CornerRadius="{StaticResource RadiusSm}" Padding="12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Name="StatusIcon" Text="..."
                                   FontSize="{StaticResource FontSize.Body}"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Name="StatusMessageText" Text=""
                                   FontSize="{StaticResource FontSize.Caption}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Name="ConnectButton" Content="Connect" Click="Connect_Click"
                    Style="{StaticResource Dialog.PrimaryAction}" MinWidth="120" IsDefault="True"
                    AutomationProperties.Name="Connect to phone"/>
            <Button Content="Cancel" Click="Cancel_Click"
                    Style="{StaticResource Dialog.SecondaryAction}" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</views:AppDialogWindow>
