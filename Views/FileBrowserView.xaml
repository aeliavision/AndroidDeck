<UserControl x:Class="VcfEditor.Views.FileBrowserView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:VcfEditor.Behaviors"
             xmlns:helpers="clr-namespace:VcfEditor.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1180"
             Background="{DynamicResource Brush.Background}"
             behaviors:ResponsiveLayoutBehavior.IsEnabled="True"
             Tag="{Binding Path=(behaviors:ResponsiveLayoutBehavior.Mode), RelativeSource={RelativeSource Self}}"
             AllowDrop="True"
             Drop="View_Drop"
             DragOver="View_DragOver">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderPanel}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Files" Style="{StaticResource DisplayText}"
                               AutomationProperties.HeadingLevel="Level1"/>
                    <TextBlock Text="Browse and transfer files over your secure local connection."
                               Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Upload to phone"
                            Command="{Binding Actions.UploadCommand, ElementName=Root}"
                            Style="{StaticResource PrimaryCommandButton}"
                            AutomationProperties.Name="Upload files to phone"/>
                    <Button Content="Download to PC"
                            Command="{Binding Actions.DownloadCommand, ElementName=Root}"
                            Style="{StaticResource ContextCommandButton}"
                            AutomationProperties.Name="Download selected files to PC"/>
                    <Button Content="More"
                            Tag="{Binding Actions, ElementName=Root}"
                            behaviors:ButtonContextMenuBehavior.IsEnabled="True"
                            Style="{StaticResource ContextCommandButton}"
                            AutomationProperties.Name="More file actions">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="New folder" Command="{Binding CreateFolderCommand}"/>
                                <MenuItem Header="Rename" Command="{Binding RenameCommand}"/>
                                <MenuItem Header="Move" Command="{Binding MoveCommand}"/>
                                <Separator/>
                                <MenuItem Header="Delete" Command="{Binding DeleteCommand}"/>
                                <Separator/>
                                <MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CommandBarPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Back" Command="{Binding Actions.BackCommand, ElementName=Root}"
                        Style="{StaticResource ContextCommandButton}" Margin="0,0,8,0"
                        AutomationProperties.Name="Go to parent folder"/>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Focusable="True" AutomationProperties.Name="Breadcrumbs">
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Label}" Tag="{Binding Path}"
                                            Click="Breadcrumb_Click" Style="{StaticResource ContextCommandButton}"
                                            Padding="8,4" Margin="0" MinHeight="36"
                                            AutomationProperties.Name="{Binding Label}"/>
                                    <TextBlock Text="/" VerticalAlignment="Center" Margin="4,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="12,0,8,0" MinHeight="40" VerticalContentAlignment="Center"
                         Style="{StaticResource ModernTextBox}"
                         ToolTip="Search this folder" AutomationProperties.Name="Search files"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="List" Click="ListViewMode_Click" Style="{StaticResource ContextCommandButton}"
                            MinHeight="40" AutomationProperties.Name="Show list view"/>
                    <Button Content="Grid" Click="GridViewMode_Click" Style="{StaticResource ContextCommandButton}"
                            MinHeight="40" AutomationProperties.Name="Show grid view"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="0" ClipToBounds="True">
                <Grid>
                    <ListView x:Name="FileListView" ItemsSource="{Binding ItemsView}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              SelectionMode="Extended" SelectionChanged="FileSelectionChanged"
                              MouseDoubleClick="FileList_DoubleClick" KeyDown="FileList_KeyDown"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              AutomationProperties.Name="Files list">
                        <ListView.Style>
                            <Style TargetType="ListView" BasedOn="{StaticResource ModernListView}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Style>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource ModernListViewItem}"/>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="360" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Type" Width="180" DisplayMemberBinding="{Binding MimeType}"/>
                                <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                <GridViewColumn Header="Modified" Width="160" DisplayMemberBinding="{Binding LastModifiedLocal, StringFormat={}{0:g}}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <ListBox x:Name="FileGrid" ItemsSource="{Binding ItemsView}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             SelectionMode="Extended" SelectionChanged="FileSelectionChanged"
                             MouseDoubleClick="FileGrid_DoubleClick" KeyDown="FileGrid_KeyDown"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Standard"
                             AutomationProperties.Name="Files grid">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><helpers:VirtualizingWrapPanel ItemWidth="184" ItemHeight="132"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="180" MinHeight="112" Margin="8" Padding="12" Style="{StaticResource ModernCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding MimeType}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="DropHint" Visibility="Collapsed" Background="{DynamicResource Brush.PrimaryContainer}"
                            BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="2" Margin="16" CornerRadius="{StaticResource RadiusLg}"
                            Panel.ZIndex="10">
                        <TextBlock Text="Drop files here to upload to the phone" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource TitleText}"/>
                    </Border>

                    <Border Margin="16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RequiresAllFilesAccess}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasVisibleItems}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="No files found" Style="{StaticResource TitleText}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Try another folder or clear the search." Style="{StaticResource BodyText}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Permission required overlay -->
                    <Border Margin="16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RequiresAllFilesAccess}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource IconSize.Hero}"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Primary}"
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="All Files Access required" Style="{StaticResource TitleText}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                                       Style="{StaticResource BodyText}" Margin="0,12,0,0">
                                On your Android phone, open the AndroidDeck companion app and
                                grant <Bold>All Files Access</Bold> (Settings → Apps → AndroidDeck → Permissions).
                                Then tap <Bold>Retry</Bold> in the app or reconnect from the desktop.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="PreviewPanel" Grid.Column="1" Style="{StaticResource ModernCard}" Margin="12,0,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Preview" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Text="{Binding SelectedItem.Name}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedItem.Path}" Style="{StaticResource CaptionText}" Margin="0,4,0,16" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedItem.MimeType, StringFormat=Type: {0}}" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="{Binding SelectedItem.SizeDisplay, StringFormat=Size: {0}}" Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding SelectedItem.LastModifiedLocal, StringFormat=Modified: {0:g}}" Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Button x:Name="PreviewFlyoutButton" Grid.Column="0" Content="Preview" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"
                    Click="PreviewFlyoutButton_Click" Style="{StaticResource PrimaryCommandButton}" Panel.ZIndex="15"/>
            <Border x:Name="PreviewFlyout" Grid.ColumnSpan="2" Visibility="Collapsed" Width="340"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="16" Padding="20"
                    Style="{StaticResource ModernCard}" Panel.ZIndex="20">
                <StackPanel>
                    <Button Content="Close" Click="ClosePreviewFlyoutButton_Click" HorizontalAlignment="Right"
                            Style="{StaticResource ContextCommandButton}"/>
                    <TextBlock Text="Preview" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="{Binding SelectedItem.Name}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedItem.Path}" Style="{StaticResource CaptionText}" Margin="0,4,0,16" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedItem.MimeType, StringFormat=Type: {0}}" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="{Binding SelectedItem.SizeDisplay, StringFormat=Size: {0}}" Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3">
            <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource StatusBanner.Error}" Margin="0,12,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Retry" Command="{Binding Actions.RetryTransferCommand, ElementName=Root}"
                            Style="{StaticResource ContextCommandButton}"/>
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource OperationCenterCard}"
                    Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Transfer operation" Style="{StaticResource TitleText}"/>
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding Actions.CancelTransferCommand, ElementName=Root}"
                                Style="{StaticResource ContextCommandButton}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,8,0,6"/>
                    <ProgressBar Value="{Binding TransferProgress, Mode=OneWay}" Maximum="100" Height="8"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OperationCenterCard}"
                    Visibility="{Binding HasTransferOutcomes, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Operation results" Style="{StaticResource TitleText}"/>
                        <Button DockPanel.Dock="Right" Content="Retry last transfer" Command="{Binding Actions.RetryTransferCommand, ElementName=Root}"
                                Style="{StaticResource ContextCommandButton}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding TransferOutcomes}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Direction}" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
